// Handwritten composition fixture for operation-driven emission.
module {
  tt.func public @constants(%p0: tensor<32x32x!tt.ptr<bf16>>, %p1: tensor<32x32x!tt.ptr<bf16>>, %out: tensor<32x32x!tt.ptr<bf16>>) {
    %x0 = tt.load %p0 : tensor<32x32x!tt.ptr<bf16>>
    %x1 = tt.load %p1 : tensor<32x32x!tt.ptr<bf16>>
    %s = arith.constant -0.5 : bf16
    %c = tt.splat %s : bf16 -> tensor<32x32xbf16>
    %m = arith.mulf %x0, %c : tensor<32x32xbf16>
    %r = arith.addf %m, %x1 : tensor<32x32xbf16>
    tt.store %out, %r : tensor<32x32x!tt.ptr<bf16>>
    tt.return
  }
}
