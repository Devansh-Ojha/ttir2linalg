graph linear_kernel {
  %arg0: buffer<f32>
  %arg1: buffer<f32>
  %arg2: buffer<f32>
  %arg3: buffer<f32>
  %c4_i32 = constant() value='4', type='i32'
  %0 = partition_id() axis='0 : i32'
  %1 = range() end='4 : i32', start='0 : i32'
  %2 = broadcast(%arg0)
  %3 = address_offset(%2, %1)
  %4 = load(%3)
  %5 = integer_multiply(%0, %c4_i32)
  %6 = address_offset(%arg1, %5)
  %7 = broadcast(%6)
  %8 = address_offset(%7, %1)
  %9 = load(%8)
  %10 = address_offset(%arg2, %0)
  %11 = load(%10)
  %12 = multiply(%4, %9)
  %13 = reshape(%12)
  %14 = reduce(%13) axis='0 : i32', region_count=1
    region {
      %17 = add(%blkarg1_0, %blkarg1_1)
    }
  %15 = add(%14, %11)
  %16 = address_offset(%arg3, %0)
   = store(%16, %15)
  return 
}
